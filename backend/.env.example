# Copy to .env for local development. Every value here is a placeholder.

# --- Core ---
DJANGO_SECRET_KEY=
# Leave unset locally: manage.py, wsgi.py and asgi.py default to development
# settings. Set to config.settings.production on any real deployment.
DJANGO_SETTINGS_MODULE=
# Hostnames only: no scheme, no trailing slash. Comma separated.
DJANGO_ALLOWED_HOSTS=your-backend.vercel.app
# Full origins WITH scheme. Include the backend's own domain, Django admin
# login needs it.
CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# --- Database ---
# DATABASE_URL is the ONLY way to configure the database. Use your Postgres
# provider's connection string. On Supabase + serverless (Vercel), use the
# Transaction pooler string (port 6543), not the direct connection.
# If unset, local development falls back to a SQLite file. Production
# settings refuse to start on SQLite unless DJANGO_ALLOW_SQLITE=True.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Seconds Django keeps a DB connection open. 60 suits a long-running server.
# Set to 0 on serverless (Vercel) so the pooler does the pooling.
DATABASE_CONN_MAX_AGE=60
# Only for a deployment that intentionally runs SQLite in production mode
# (the PythonAnywhere preview site). Leave False everywhere else.
DJANGO_ALLOW_SQLITE=False

# --- Cache ---
# Use the standard redis:// or rediss:// connection string (NOT a REST URL
# or token). Leave unset locally to fall back to in-memory caching. In
# production this should be set: serverless instances do not share memory,
# so without Redis, rate limiting and caching are ineffective.
REDIS_URL=rediss://default:password@your-redis-host:6379
CACHE_TTL_SHORT=60
CACHE_TTL_MEDIUM=300
CACHE_TTL_SEARCH=30

# --- Security (production) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# --- Email (production only; development sends to Mailhog on localhost:1025) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Academia <no-reply@academia.local>

# --- Media storage (optional) ---
# Dotted path of the default file storage backend. Leave unset until an
# upload feature exists and a cloud backend has been installed and verified.
# DEFAULT_FILE_STORAGE_BACKEND=