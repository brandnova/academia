# Optional API override. Leave blank to auto-detect the dev machine from the
# Expo dev server - this is what makes Expo Go work on a physical phone.
# Set it explicitly for production builds, tunnel mode, or a remote backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1

# Google sign in. Web client id only: Android and iOS use the native account picker, and Google matches the
# Android client by package name and SHA-1 (it must live in the same Cloud project as the Web client).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Dev-only escape hatch: a pre-seeded JWT pair so you can test authenticated
# screens without configuring Google. Never set these in a production build.
EXPO_PUBLIC_DEV_ACCESS_TOKEN=
EXPO_PUBLIC_DEV_REFRESH_TOKEN=


# Web app used by staff handoff links and share links.
EXPO_PUBLIC_WEB_BASE_URL=https://academia-prvw.vercel.app

# Comma separated user ids that get the official "A" badge.
EXPO_PUBLIC_PLATFORM_ACCOUNT_ID=

# Dev only. Enables pasting a seeded test token on Login.
EXPO_PUBLIC_DEV_MODE=0

# Shown next to the suspended-account message.
EXPO_PUBLIC_SUPPORT_EMAIL=brandnova.dev@gmail.com
